rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 100 &&
             data.streamerHandle is string &&
             data.streamerHandle.size() > 0 &&
             data.streamerHandle.size() <= 50 &&
             data.coinBalance is int &&
             data.coinBalance >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             (!('diamondsEarned' in data) || (data.diamondsEarned is int && data.diamondsEarned >= 0)) &&
             (!('followerCount' in data) || (data.followerCount is int && data.followerCount >= 0)) &&
             (!('isVerified' in data) || data.isVerified is bool) &&
             (!('twitchStreamKey' in data) || (data.twitchStreamKey is string && data.twitchStreamKey.size() <= 200)) &&
             (!('youtubeStreamKey' in data) || (data.youtubeStreamKey is string && data.youtubeStreamKey.size() <= 200)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);
    }
  }
}
